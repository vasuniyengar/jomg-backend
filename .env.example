NODE_ENV=development
PORT=4000

# Temporary prod debugging only — return real 5xx error messages to API clients.
# Remove or set false after fixing the issue.
EXPOSE_API_ERRORS=false

# PostgreSQL
POSTGRES_DB=jomg
POSTGRES_USER=jomg
POSTGRES_PASSWORD=jomg_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jomg:jomg_password@localhost:5432/jomg?schema=public

# Security
JWT_SECRET=change_me
CORS_ALLOWED_ORIGINS=http://localhost:3000
BODY_LIMIT=1mb

# Optional integrations
FRONTEND_URL=http://localhost:3000
SERVER_BASE_URL=http://localhost:4000

# Media uploads: local (dev default) or s3 (production)
# auto = local in development, s3 in production when AWS_BUCKET_NAME is set
MEDIA_STORAGE=local
LOCAL_MEDIA_BASE_URL=http://localhost:4000/uploads

# AWS (S3 + email queue) — only needed when MEDIA_STORAGE=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
EMAIL_QUEUE_URL=

# SMTP (used by email worker — not the API process)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
